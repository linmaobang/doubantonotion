{
  "manifest_version": 3,
  "name": "豆瓣同步到 Notion",
  "version": "3.1.0",
  "description": "一键或批量把豆瓣图书、电影、剧集（含你的标记和评分）保存到 Notion 数据库。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://book.douban.com/*",
    "https://movie.douban.com/*",
    "https://m.douban.com/*",
    "https://*.doubanio.com/*",
    "https://api.notion.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
